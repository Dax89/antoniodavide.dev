---
import Page from "../../layouts/Page.astro";
import { getTags } from "../../utils.js";

const tags = await getTags();
---

<Page title="Tags" description="All the tags used in posts.">
    <ul>
        {Object.keys(tags).map(x => <li class="inline-block mx-3">
            <a class="flex items-center space-x-1 font-bold border-accent hover:border-b" 
                href={`/tags/${x}`}>
                <p class="text-2xl text-muted">#</p>
                <p class="font-bold">{x} ({tags[x]})</p>
            </a>
        </li>)}
    </ul>
</Page>

