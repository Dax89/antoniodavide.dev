---
import dayjs from "dayjs";
import { render } from "astro:content";
import { getPosts } from "../../../utils.js";
import Article from "../../../layouts/Article.astro";
import Tag from "../../../components/Tag.astro";

export async function getStaticPaths() {
    const posts = await getPosts();
    return posts.map((post) => ({
        params: { slug: post.id },
        props: post,
    }));
}

const post = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const date = dayjs(post.data.published).format("DD MMMM YYYY");
---

<Article title={post.data.title} description={post.data.description}>
    <div slot="header" class="flex items-center text-sm mb-5 space-x-3">
        <p class="italic">{date}</p>
        <div class="text-muted text-lg">|</div>
        <p>{remarkPluginFrontmatter.minutesRead}</p>
        <div class="text-muted text-lg">|</div>
        { Array.isArray(post.data.tags) && <ul class="flex items-center space-x-3"> 
            {post.data.tags.map(x => <li> 
                <a class="text-accent hover:border-b hover:border-b-2" href={`/tags/${x}`}>#{x}</a>
            </li>)}
        </ul> }
    </div>
    <Content/>
</Article>
