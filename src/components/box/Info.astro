---
import { Icon } from "astro-icon/components";

const { message } = Astro.props
---

<div class="text-info flex items-center border border-info my-5 p-2 space-x-1">
    <div>
        <Icon class="p-1" name="mdi:information-variant" size="2.5rem"/>
    </div>
    <div class="italic">
        {message}
    </div>
</div>


